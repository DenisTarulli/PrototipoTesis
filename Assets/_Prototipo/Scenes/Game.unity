    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "\u2022  Algunos botones se van a iluminar uno por uno.\n\u2022  Cuando
    termine, toc\xE1 los botones en el mismo orden.\n\u2022  Son 3 rondas, cada una
    con una secuencia nueva.\n\u2022  Si te equivoc\xE1s, la secuencia se vuelve
    a mostrar y lo intent\xE1s de nuevo.\n\u2022  La pista vuelve a mostrar la secuencia
    de la ronda."
